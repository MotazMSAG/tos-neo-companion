<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Operator-run diagnostic (EVIDENCE c13 follow-up): does Windows.Graphics.Capture see the home-monitor part of the game
    client while the window is slid cross-monitor, where the PW_RENDERFULLCONTENT capture shows black?
    Never run by the host, the build or the tests. It finds the game like GameIO, refuses while the game is foreground or
    minimized, moves the window move-only (flags 0x0215) through GameIO's internal layer (Diagnostics\ProbeWindow), captures
    with both methods, moves it back home and writes PNGs (chat blacked out, IVision.EncodePng) plus a report.
    No window messages at all: no clicks, no focus messages, no keys. Own P/Invokes: d3d11 device creation only
    (StaticRules.PInvokeAllowlist["Companion.CaptureProbe"]).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Companion.CaptureProbe</RootNamespace>
    <AssemblyName>Companion.CaptureProbe</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <!-- SYSLIB1054: LibraryImport needs AllowUnsafeBlocks, which Directory.Build.props forbids. -->
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Companion.Contracts\Companion.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Companion.GameIO\Companion.GameIO.csproj" />
    <ProjectReference Include="..\..\src\Companion.Vision\Companion.Vision.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Companion.GameIO.Tests" />
  </ItemGroup>
</Project>
