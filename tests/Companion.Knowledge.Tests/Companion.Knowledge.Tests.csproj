<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline tests for unit "knowledge-planner" (SPEC 13). Layout copied from tests\Companion.Contracts.Tests.
       Temporary files go under this project's output folder (bin\...\tmp), never outside companion\. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Companion.Contracts\Companion.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Companion.Knowledge\Companion.Knowledge.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\src\Companion.Knowledge\seed\*.json" LinkBase="seed" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
