<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit "engine-nav" engine tests (SPEC 13): scenario tests with scripted fakes, journal and artifact store. Offline only. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Library</OutputType>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Companion.Contracts\Companion.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Companion.Engine\Companion.Engine.csproj" />
    <ProjectReference Include="..\..\src\Companion.Navigation\Companion.Navigation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\data\ui-map.json" Link="data\ui-map.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\procedures.json" Link="data\procedures.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The CraftLoop round runs through the real engine in CraftLoopRoundTests (data only, no feature code). -->
    <None Include="..\..\features\Companion.Feature.Crafting\data\procedures.json" Link="data\features\crafting\procedures.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Stock scan's runs (inventory.scanStock, inventory.stockTip) in ScanStockRoundTests (data only, no feature code). -->
    <None Include="..\..\features\Companion.Feature.Inventory\data\procedures.json" Link="data\features\inventory\procedures.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
