<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reference test project layout for every unit (SPEC 13): MSTest.TestFramework + MSTest.TestAdapter + Microsoft.NET.Test.Sdk (the MSTest metapackage pulls Mono.Cecil: not Microsoft-published), offline tests only. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Companion.Contracts\Companion.Contracts.csproj" />
  </ItemGroup>
</Project>

